{
  "name": "bookmarks-e2e",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile.e2e"
  },
  "containerEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright"
  },
  "remoteUser": "root",
  "forwardPorts": [8000, 8001, 9323],
  "postCreateCommand": "bun install --frozen-lockfile && uv sync --frozen",
  "customizations": {
    "vscode": {
      "extensions": ["ms-playwright.playwright"]
    }
  }
}
