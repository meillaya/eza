{
  "name": "playwright-e2e",
  "image": "mcr.microsoft.com/playwright:v1.62.1-noble",
  "containerEnv": {
    "PLAYWRIGHT_INCLUDE_WEBKIT": "1",
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright"
  },
  "forwardPorts": [6080, 9323],
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "postCreateCommand": "curl -fsSL https://bun.sh/install | bash -s -- bun-v1.3.11 && bun install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": ["ms-playwright.playwright"]
    }
  }
}
