cabal-version:      3.0
name:               eza-web
version:            0.2.0.0
synopsis:           eza Miso frontend
description:        WebAssembly Miso client for eza.
license:            Apache-2.0
author:             eza
maintainer:         eza
build-type:         Simple

common web-common
  default-language: Haskell2010
  default-extensions:
    DeriveAnyClass
    DeriveGeneric
    LambdaCase
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    TypeApplications
  -- -fno-specialise keeps the WASM bundle inside the size ceiling while the
  -- M2-B2b migration still carries the transitional MisoString facade; drop it
  -- when the reducer migration removes that duplication.
  ghc-options:      -Wall -fno-specialise
  if arch(wasm32)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"
    cpp-options: -DWASM

executable eza-web
  import:           web-common
  hs-source-dirs:   src
  main-is:          Main.hs
  other-modules:    Eza.Web.History
                    Eza.Web.Api
                    Eza.Web.Detail
                    Eza.Web.Error
                    Eza.Web.Graph
                    Eza.Web.Interpreter
                    Eza.Web.Markdown
                    Eza.Web.Model
                    Eza.Web.Panels
                    Eza.Web.Render
                    Eza.Web.Render.Event
                    Eza.Web.Update
                    Eza.Web.Update.Account
                    Eza.Web.Update.Common
                    Eza.Web.Update.Dedup
                    Eza.Web.Update.Detail
                    Eza.Web.Update.Graph
                    Eza.Web.Update.ImportExport
                    Eza.Web.Update.Ledger
                    Eza.Web.Update.Maintenance
                    Eza.Web.Update.Route
                    Eza.Web.Update.Shell
                    Eza.Web.Update.Tags
                    Eza.Web.Update.ViewDefs
                    Eza.Web.Update.Views
                    Eza.Web.View
                    Eza.Web.Widgets
  build-depends:    base >=4.18 && <5
                  , aeson
                  , bytestring
                  , containers
                  , eza-core
                  , eza-web-logic
                  , miso
                  , mtl
                  , text
