{
  "id": "/",
  "name": "eza, the catalogue",
  "short_name": "eza",
  "description": "A private catalogue of saved links: search, tags, and a reading copy, kept in one SQLite file.",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#F2EDE3",
  "background_color": "#F2EDE3",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "{{asset:icons/icon-192.png}}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{asset:icons/icon-512.png}}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{asset:icons/icon-512.png}}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/save",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
