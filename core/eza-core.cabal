cabal-version:      3.0
name:               eza-core
version:            0.1.0.0
synopsis:           Shared pure types and logic for eza
description:        DTOs, JSON codecs, search-query parsing, wikilink parsing,
                    and URL normalization shared by the Haskell server and the
                    Miso client.
license:            Apache-2.0
author:             eza
maintainer:         eza
build-type:         Simple

library
  hs-source-dirs:   src
  exposed-modules:  Eza.Types
                    Eza.Json
                    Eza.SearchQuery
                    Eza.Wikilink
                    Eza.Url
  build-depends:    base >=4.18 && <5
                  , aeson >=2.1 && <2.4
                  , bytestring
                  , containers
                  , text
  default-language: Haskell2010
  default-extensions:
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    TypeApplications
  ghc-options:      -Wall -Wcompat -Wincomplete-uni-patterns
