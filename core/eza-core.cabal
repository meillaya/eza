cabal-version:      3.0
name:               eza-core
version:            0.2.0.0
synopsis:           Shared pure types and logic for eza
description:        DTOs, JSON codecs, search-query parsing, wikilink parsing,
                    and URL normalization shared by the Haskell server and the
                    Miso client.
license:            Apache-2.0
author:             eza
maintainer:         eza
build-type:         Simple

library
  hs-source-dirs:   src
  exposed-modules:  Eza.Account
                    Eza.Ai
                    Eza.Authz
                    Eza.Boot
                    Eza.Consolidation
                    Eza.GraphLayout
                    Eza.GraphMatch
                    Eza.Json
                    Eza.Ledger
                    Eza.Problem
                    Eza.Rule
                    Eza.Routes
                    Eza.SearchQuery
                    Eza.Share
                    Eza.Time
                    Eza.TokenPrefix
                    Eza.Types
                    Eza.Url
                    Eza.User
                    Eza.View
                    Eza.Webhook
                    Eza.Wikilink
  build-depends:    base >=4.18 && <5
                  , aeson >=2.1 && <2.4
                  , bytestring
                  , containers
                  , text
  default-language: Haskell2010
  default-extensions:
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    TypeApplications
  ghc-options:      -Wall -Wcompat -Wincomplete-uni-patterns

test-suite eza-core-test
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:    ContractSpec
  build-depends:    base >=4.18 && <5
                  , aeson >=2.1 && <2.4
                  , eza-core
                  , hspec
                  , text
  default-language: Haskell2010
  default-extensions:
    LambdaCase
    OverloadedStrings
  ghc-options:      -Wall -Wcompat -Wincomplete-uni-patterns
