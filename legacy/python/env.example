# Bookmarks — environment configuration
# Copy to .env and adapt, or export these in your shell / service manager.
# All values shown below are the built-in defaults.

# Full URL of the public-facing origin. The host part drives the prod
# predicate (anything but 127.0.0.1/localhost is prod) and the session
# cookie Secure flag.
PUBLIC_ORIGIN=http://localhost:8000

# SQLite database file. Parent directory is created automatically at startup.
BOOKMARKS_DB=/path/to/bookmarks/data/bookmarks.db

# WebAuthn relying-party ID. Defaults to the PUBLIC_ORIGIN host (localhost in
# dev, registrable domain otherwise — set explicitly for subdomain deploys).
WEBAUTHN_RP_ID=localhost

# Human-readable relying-party name shown in the browser prompt.
WEBAUTHN_RP_NAME=Bookmarks

# Session cookie lifetime in seconds (default: 30 days).
SESSION_TTL_SECONDS=2592000

# Secret key for signing session cookies. WARNING: if unset in production
# (non-loopback PUBLIC_ORIGIN) the app logs a loud warning and falls back to
# an insecure dev default. Always set this in prod.
SECRET_KEY=change-me-to-a-long-random-string

# Directory for database backups.
BACKUP_DIR=/path/to/bookmarks/data/backups

# Optional off-box destination (rsync/ssh path, mounted volume, ...) that
# backup snapshots are copied to.
BACKUP_OFFBOX_DEST=
