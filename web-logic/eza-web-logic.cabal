cabal-version:      3.0
name:               eza-web-logic
version:            0.2.0.0
synopsis:           Miso-free client logic for eza
description:        The client's route algebra and client request model, free of
                    Miso, WebAssembly and browser dependencies. The package
                    builds natively so the URL grammar, the request table and
                    the shared route truth can be tested without a WASM
                    toolchain; web/ keeps only the Miso boundary.
license:            Apache-2.0
author:             eza
maintainer:         eza
build-type:         Simple

common logic-common
  default-language: Haskell2010
  default-extensions:
    LambdaCase
    OverloadedStrings
  ghc-options:      -Wall -Wcompat -Wincomplete-uni-patterns

library
  import:           logic-common
  hs-source-dirs:   src
  exposed-modules:  Eza.Web.Logic.Api
                    Eza.Web.Logic.Route
  build-depends:    base >=4.18 && <5
                  , bytestring
                  , eza-core
                  , text

test-suite eza-web-logic-test
  import:           logic-common
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:    ApiSpec
                    PuritySpec
                    RouteSpec
  build-depends:    base >=4.18 && <5
                  , directory
                  , eza-core
                  , eza-web-logic
                  , filepath
                  , hspec
                  , text
