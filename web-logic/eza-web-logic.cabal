cabal-version:      3.0
name:               eza-web-logic
version:            0.4.0.0
synopsis:           Miso-free client logic for eza
description:        The client's route algebra, client request model, effect
                    algebra and native reducers, free of Miso, WebAssembly and
                    browser dependencies. The package builds natively so the
                    URL grammar, the request table, the shared route truth and
                    the ledger/search reducer can be tested without a WASM
                    toolchain; web/ keeps only the Miso boundary.
license:            Apache-2.0
author:             eza
maintainer:         eza
build-type:         Simple

common logic-common
  default-language: Haskell2010
  default-extensions:
    LambdaCase
    OverloadedStrings
  ghc-options:      -Wall -Wcompat -Wincomplete-uni-patterns

library
  import:           logic-common
  hs-source-dirs:   src
  exposed-modules:  Eza.Web.Logic.Api
                    Eza.Web.Logic.Effect
                    Eza.Web.Logic.Error
                    Eza.Web.Logic.Job
                    Eza.Web.Logic.Ids
                    Eza.Web.Logic.Graph.Geometry
                    Eza.Web.Logic.Graph
                    Eza.Web.Logic.Input
                    Eza.Web.Logic.Ledger
                    Eza.Web.Logic.Browser
                    Eza.Web.Logic.Update.Common
                    Eza.Web.Logic.Update.Views
                    Eza.Web.Logic.Update.ViewDefs
                    Eza.Web.Logic.Update.Route
                    Eza.Web.Logic.Update.Shell
                    Eza.Web.Logic.Update.Ledger
                    Eza.Web.Logic.Update.Detail
                    Eza.Web.Logic.Update.Account
                    Eza.Web.Logic.Update.Graph
                    Eza.Web.Logic.Update.Maintenance
                    Eza.Web.Logic.Update.Tags
                    Eza.Web.Logic.Update
                    Eza.Web.Logic.Update.Dedup
                    Eza.Web.Logic.Update.Job
                    Eza.Web.Logic.Update.ImportExport
                    Eza.Web.Logic.Update.Monad
                    Eza.Web.Logic.Requests
                    Eza.Web.Logic.Model
                    Eza.Web.Logic.Route
                    Eza.Web.Logic.Wire
  build-depends:    base >=4.18 && <5
                  , aeson
                  , bytestring
                  , containers
                  , eza-core
                  , text

test-suite eza-web-logic-test
  import:           logic-common
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:    ApiSpec
                    HelperSpec
                    LedgerSpec
                    JobSpec
                    ModelSpec
                    UpdateSpec
                    ViewSpec
                    PuritySpec
                    PolishSpec
                    RouteSpec
  build-depends:    base >=4.18 && <5
                  , aeson
                  , containers
                  , directory
                  , eza-core
                  , eza-web-logic
                  , filepath
                  , hspec
                  , text
