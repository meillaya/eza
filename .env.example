# eza runtime configuration (see README.md / docs/)
EZA_DATA_DIR=./data
EZA_DB=./data/eza.db
EZA_BIND=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:8080
EZA_RP_ID=localhost
EZA_RP_NAME=eza
EZA_STATIC_DIR=./static
EZA_ALLOWED_ORIGINS=http://localhost:8080
EZA_SESSION_TTL_SECONDS=2592000
EZA_SNAPSHOT_DIR=./data/snapshots
EZA_MONOLITH=monolith
EZA_BACKUP_DIR=./data/backups
# EZA_BACKUP_OFFSITE=/mnt/backups/eza
# AI tagging is optional; prefer SecretSpec (secretspec.toml) over a .env file.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# EZA_AI_PROVIDER=anthropic
# EZA_OPENAI_BASE_URL=https://api.openai.com/v1
EZA_LOG_LEVEL=info
