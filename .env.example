# eza runtime configuration (see README.md / docs/)
EZA_DATA_DIR=./data
EZA_DB=./data/eza.db
EZA_BIND=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:8080
EZA_RP_ID=localhost
EZA_RP_NAME=eza
EZA_STATIC_DIR=./static
EZA_ALLOWED_ORIGINS=http://localhost:8080
# Proxy CIDRs allowed to set X-Forwarded-For (auth rate limiters key on the
# right-most untrusted hop when the socket peer is trusted). Empty by default.
# EZA_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Browser-clipper origins (extension origins are also accepted automatically):
# EZA_CLIP_ORIGINS=chrome-extension://abcdefghijklmnop
# Optional Defuddle sidecar command, run as a child process (node sidecar/src/main.mjs):
# EZA_DEFUDDLE_CMD=node sidecar/src/main.mjs
EZA_SESSION_TTL_SECONDS=2592000
EZA_LOGIN_MAX_ATTEMPTS=5
EZA_LOGIN_LOCKOUT_SECONDS=900
EZA_AUTH_BODY_LIMIT_BYTES=8192
EZA_ARGON2_MEMORY_KIB=65536
EZA_ARGON2_ITERATIONS=3
EZA_ARGON2_PARALLELISM=2
EZA_SNAPSHOT_DIR=./data/snapshots
EZA_MONOLITH=monolith
EZA_FAVICON_MAX_BYTES=262144
EZA_FAVICON_TTL_DAYS=90
EZA_FAVICON_BACKFILL=1
EZA_BACKUP_DIR=./data/backups
EZA_BACKUP_KEEP_DAYS=14
EZA_SNAPSHOT_MAX_BYTES=52428800
EZA_MAX_BODY_BYTES=8388608
EZA_IMPORT_MAX_BYTES=33554432
# AI tagging is optional; prefer SecretSpec (secretspec.toml) over a .env file.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# EZA_AI_PROVIDER=anthropic
# EZA_OPENAI_BASE_URL=https://api.openai.com/v1
# debug logs the full request line, info one access line per request, warn/error no access log.
EZA_LOG_LEVEL=info
